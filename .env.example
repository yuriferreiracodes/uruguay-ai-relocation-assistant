APP_ENV=development

# Any OpenAI-compatible chat completions API (base URL without /chat/completions)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

MAX_HISTORY_MESSAGES=6
MAX_MESSAGE_LENGTH=2000
MAX_OUTPUT_TOKENS=600

RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# Set to true only behind a trusted proxy (Render, Railway) to use X-Forwarded-For
TRUST_PROXY_HEADERS=false

RETRIEVAL_TIMEOUT_SECONDS=5
RETRIEVAL_CACHE_TTL_SECONDS=21600
